# .pre-commit-config.yaml — TEMPLATE (controlled-build-run-kit).
#
# The deterministic commit gate. These are FACTS (not LLM opinions), so they are
# allowed to BLOCK a commit. Arm with `pre-commit install` (or `uv run pre-commit
# install` if you manage pre-commit through uv). A rare false positive gets a
# conscious inline suppression (`# type: ignore[...]`, `# noqa: ...`), never `--no-verify`.
#
# PORTING CHECKLIST:
#   1. Replace the format/lint/type/test hooks with YOUR repo's real commands
#      (the ones below are placeholders). Remove any that don't apply.
#   2. Per-commit reviews are ADVISORY (2026-08-31 cadence move): nothing here
#      blocks on RoboRev — the blocking review check lives on the merge path.
#   3. KEEP `gitleaks` only if you install it (`brew install gitleaks`); else delete it.

# A merge that auto-commits fires ONLY pre-merge-commit — git has NO fallback
# to the pre-commit hook there — so both types must be installed or every
# commit-stage gate is silently bypassed on the primary merge path.
default_install_hook_types: [pre-commit, pre-merge-commit]
repos:
  - repo: local
    hooks:
      # --- TODO: your deterministic checks (replace these placeholders) ---------
      - id: format-check
        name: format (check only, never rewrites)
        entry: 'echo "TODO your formatter check command"'   # e.g. uv run ruff format --check . | npm run format:check
        language: system
        pass_filenames: false
        always_run: true
      - id: lint
        name: lint
        entry: 'echo "TODO your lint command"'                # e.g. uv run ruff check . | npm run lint
        language: system
        pass_filenames: false
        always_run: true
      - id: typecheck
        name: types
        entry: 'echo "TODO your typechecker command"'         # e.g. uv run mypy <pkgs> | npm run typecheck
        language: system
        pass_filenames: false
        always_run: true
      - id: tests
        name: tests
        entry: 'echo "TODO your test command"'                # e.g. uv run pytest <pkgs> | npm test
        language: system
        pass_filenames: false
        always_run: true

      # --- KEEP VERBATIM: the merge-boundary review wall (needs scripts/merge-review-gate.sh) ---
      - id: merge-review-gate
        name: merge review gate (scripts/merge-review-gate.sh)
        entry: ./scripts/merge-review-gate.sh
        language: system
        pass_filenames: false
        always_run: true

      # --- OPTIONAL: staged-secret scan (delete if you don't install gitleaks) ---
      - id: gitleaks
        name: gitleaks (staged secrets)
        entry: gitleaks protect --staged --redact
        language: system
        pass_filenames: false
        always_run: true

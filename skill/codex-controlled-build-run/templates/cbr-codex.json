{
  "schemaVersion": 1,
  "builderBranchPattern": "^stream/",
  "integrationBranchPattern": "^integration/",
  "releaseBranches": ["main", "master"],
  "worktreeParent": "..",
  "worktreePrefix": "EDIT-ME-",
  "activePlanPath": "task_plan.md",
  "models": {
    "builder": "gpt-5.6-sol",
    "builderReasoning": "high",
    "reviewerAgent": "claude-code",
    "reviewer": "claude-sonnet-5",
    "reviewerReasoning": "standard",
    "probityJudge": "gpt-5.6-sol"
  },
  "modelContextTokens": 350000,
  "autoCompactTokenLimit": 297500,
  "guardedPaths": [
    "packages/**/*.{ts,tsx}",
    "adapters/**/*.ts",
    "src/**/*.{ts,tsx}"
  ],
  "reinjectionDocs": ["CONSTITUTION.md", "AGENTS.md"],
  "setupCommands": [],
  "toolchainProbe": "EDIT-ME",
  "verificationCommands": ["EDIT-ME"],
  "liveSmokeCommand": "EDIT-ME",
  "stallSeconds": 900,
  "reviewFailGraceSeconds": 600,
  "samePhaseCrashLimit": 2,
  "productPaths": ["packages", "src"]
}
